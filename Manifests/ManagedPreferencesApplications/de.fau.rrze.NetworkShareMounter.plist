							<string>authType</string>
							<key>pfm_require</key>
							<string>always</string>
							<key>pfm_range_list</key>
							<array>
								<string>krb</string>
								<string>pwd</string>
								<string>guest</string>
							</array>
							<key>pfm_range_list_titles</key>
							<array>
								<string>Kerberos</string>
								<string>Password</string>
								<string>Guest</string>
							</array>
